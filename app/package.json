{
  "name": "virtuosa-series",
  "version": "0.1.0",
  "description": "for support my old keyboard vx5 😉",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run ./server.js",
    "start": "bun run ./server.js",
    "build:css": "bunx tailwindcss -i ./src/input.css -o ./src/styles.css",
    "build": "bun run build:css && bun build ./src/app.js --outdir ./dist --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
